# Docker Compose database password (use: openssl rand -hex 32 for a VM)
POSTGRES_PASSWORD=gpu_telemetry_dev

DATABASE_URL=postgres://gpu_telemetry:gpu_telemetry_dev@localhost:5432/gpu_telemetry?sslmode=disable
HTTP_PORT=8080
TELEMETRY_CSV_PATH=./data/dcgm_metrics_20250718_134233.csv
TELEMETRY_SOURCE_ID=dcgm-metrics-sample
STREAMER_INTERVAL=500ms
COLLECTOR_WORKERS=4
COLLECTOR_BATCH_SIZE=25
COLLECTOR_POLL_INTERVAL=500ms
QUEUE_LEASE_DURATION=60s
QUEUE_MAX_ATTEMPTS=10
LOG_LEVEL=info
